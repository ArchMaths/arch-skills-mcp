//Capelet: open in a V at the front, gold-trimmed, lace at the back, standing collar, chrysanthemum emblems
# Capelet sections at each level u (0 at the neckline, 1 at the hem; measured on the sheet's front, side
# and back views): half-width kpa, depth kpf in front of the centre line and kpb behind it; kph the hem below
# 9.2 by angle; kpe the front edge's angle; kpp the angle of point q round from her left front edge.
kpa(u)=1.06546+(2*u-1)*(0.31339+(2*u-1)*(0.09931+(2*u-1)*(1.83587+(2*u-1)*((-0.94987)+(2*u-1)*((-2.48174)+(2*u-1)*((-0.77277)+(2*u-1)*(0.35379+(2*u-1)*(5.85995+(2*u-1)*(1.27103+(2*u-1)*((-6.92598)+(2*u-1)*((-0.66003)+(2*u-1)*(2.57066))))))))))))
kpb(u)=1.06919+(2*u-1)*(0.26326+(2*u-1)*((-0.13023)+(2*u-1)*(0.03978+(2*u-1)*((-2.44669)+(2*u-1)*(3.73681+(2*u-1)*(5.09705+(2*u-1)*((-9.89058)+(2*u-1)*((-3.31857)+(2*u-1)*(9.61952+(2*u-1)*((-0.04965)+(2*u-1)*((-3.29251)+(2*u-1)*(0.55213))))))))))))
kpf(u)=0.41797+(2*u-1)*(0.18656+(2*u-1)*((-0.05152)+(2*u-1)*((-0.11634)+(2*u-1)*(0.04671+(2*u-1)*(0.03458+(2*u-1)*((-0.01878)))))))
kph(c)=0.16049*c^4+(-0.11467)*c^3+0.06461*c^2+0.21128*c^1+(-0.01755)
kpe(u)=0.20278+(2*u-1)*(0.42522+(2*u-1)*(1.04303+(2*u-1)*((-1.34813)+(2*u-1)*((-3.74628)+(2*u-1)*(7.63393+(2*u-1)*(12.95808+(2*u-1)*((-25.33221)+(2*u-1)*((-25.81482)+(2*u-1)*(43.43357+(2*u-1)*(32.13419+(2*u-1)*((-35.13213)+(2*u-1)*((-22.00598)+(2*u-1)*(10.65641+(2*u-1)*(6.02707))))))))))))))
kpp(u,q)=kpe(u)*(1-2*q)+2*pi*q
kpw(q)=-cos(50.26548*q)*tanh(sin(pi*q)/0.12566)
kpx(u,p,w,s)=s*kpa(u)*sin(p)*(1+0.1*u^3*w)
kpy(u,p,w,s)=0.02-s*(kpf(u)+(kpb(u)-kpf(u))*(1-cos(p))/2)*cos(p)*(1+0.1*u^3*w)
kpz(u,p,w)=10.62-1.42*u^1.6-u^4*kph(cos(p))+0.04*u^8*w
