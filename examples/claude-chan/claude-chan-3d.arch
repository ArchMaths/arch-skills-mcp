(0.81191*(fwd(h)*sin(f))+0.0572*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.09969)*(h)+1.11963,(-0.05677)*(fwd(h)*sin(f))+0.818*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.00697*(h)+(-0.05693),0.09993*(fwd(h)*sin(f))+0.81389*(h)+2.10307,f,0.36,pi/2,h,11.87,12.51) | ref=faceBrowLeft color=#d4c2bb
# Underside of the jaw: chords between the two sides of the jawline, arched up a little in the middle.
