# Embroidery where the pleated skirt shows, at the front and the back: hem lines and a row of ferns in orange thread.
# The fern's parts as functions of the curve parameter: x across and h up from its foot (motifs.py).
fnax(t)=(((0.145)*((1-cos(2*pi*(max(0,t-1))))/2)*sin(0)+(0.058)/2*sin(2*pi*(max(0,t-1)))*1.1297*((1-cos(2*pi*(max(0,t-1))))/2)^0.15*cos(0)))
fnah(t)=((0.79*min(1,t)+((0.145)*((1-cos(2*pi*(max(0,t-1))))/2)*cos(0)-(0.058)/2*sin(2*pi*(max(0,t-1)))*1.1297*((1-cos(2*pi*(max(0,t-1))))/2)^0.15*sin(0))))
