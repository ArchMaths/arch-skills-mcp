//Skirt: cream pleated skirt with orange embroidery and a frilled petticoat
# Skirt: s from the waist (z=8.66) to the hem (z=1.61); t is the angle from the front, + toward her
# left. sa(s) is its half-width: the straight A-line of the front view. Seen from the side the front hangs
# nearly flat and the back is full, so the depth is dk(s,t) times the half-width: 0.57 at the front, 0.75
# to 1 at the back from the waist to the hem. 40 pleats (spl), 9 degrees apart as traced. sz(h) is s at height h.
sa(s)=0.43+0.079*ln(1+exp((s-0.057)/0.02))-6.5*max(0,s-0.62)^2
stp(q)=min(1,max(0,q))^2*(3-2*min(1,max(0,q)))
fk(s)=0.57-0.04*stp((s-0.5)/0.15)+0.07*stp((s-0.78)/0.14)
gk(s)=0.75+0.25*s
dk(s,t)=(fk(s)+gk(s))/2-(gk(s)-fk(s))/2*cos(t)
sz(h)=(8.66-h)/7.05
spl(s,t)=1+0.02*(0.25+0.75*s)*sin(40*t)
(sa(s)*spl(s,t)*sin(t),-sa(s)*spl(s,t)*dk(s,t)*cos(t),8.66-7.05*s,s,0,1,t,-pi,pi) | ref=underskirt color=#f3e9d8
(sa(1)*(0.99+0.06*s+0.022*s*sin(30*t))*sin(t),-sa(1)*(0.99+0.06*s+0.022*s*sin(30*t))*dk(1,t)*cos(t),1.66-0.34*s+0.03*s*cos(30*t),s,0,1,t,-pi,pi) | ref=petticoat1 color=#f3e9d8
(sa(1)*(1+0.07*s+0.022*s*sin(38*t))*sin(t),-sa(1)*(1+0.07*s+0.022*s*sin(38*t))*dk(1,t)*cos(t),1.4-0.26*s+0.03*s*cos(38*t),s,0,1,t,-pi,pi) | ref=petticoat2 color=#f8f2e8
# Embroidery where the pleated skirt shows, at the front and the back: hem lines and fern sprigs in orange thread.
curve(sa(0.955)*spl(0.955,(0+t))*1.012*sin((0+t)),-sa(0.955)*spl(0.955,(0+t))*dk(0.955,(0+t))*1.012*cos((0+t)),8.66-7.05*(0.955),t,(-0.36),0.36) | ref=hemLineF1 color=#d9a441 thickness=2
curve(sa(0.94)*spl(0.94,(0+t))*1.012*sin((0+t)),-sa(0.94)*spl(0.94,(0+t))*dk(0.94,(0+t))*1.012*cos((0+t)),8.66-7.05*(0.94),t,(-0.36),0.36) | ref=hemLineF2 color=#e8661c thickness=2
curve(sa(0.875+0.022*sin(30*t))*spl(0.875+0.022*sin(30*t),(0+t+0.012*cos(30*t)))*1.012*sin((0+t+0.012*cos(30*t))),-sa(0.875+0.022*sin(30*t))*spl(0.875+0.022*sin(30*t),(0+t+0.012*cos(30*t)))*dk(0.875+0.022*sin(30*t),(0+t+0.012*cos(30*t)))*1.012*cos((0+t+0.012*cos(30*t))),8.66-7.05*(0.875+0.022*sin(30*t)),t,(-0.36),0.36) | ref=vineF color=#e8661c thickness=2
