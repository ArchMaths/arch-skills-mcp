//Capelet: open in a V at the front, gold-trimmed, lace at the back, standing collar, chrysanthemum emblems
# Capelet sections at each level u (0 at the neckline, 1 at the hem; measured on the sheet's front, side
# and back views): half-width kpa, depth kpf in front of the centre line and kpb behind it; kph the hem below
# 9.2 by angle; kpe the front edge's angle; kpp the angle of point q round from her left front edge.
kpa(u)=0.31175+0.20511*u+5.12332*u^2+4.80503*u^3+(-36.7352)*max(0,u-0.15)^3+43.17332*max(0,u-0.3)^3+2.38848*max(0,u-0.45)^3+(-26.44117)*max(0,u-0.6)^3+11.45494*max(0,u-0.75)^3
kpb(u)=0.29317+0.84953*u+1.50512*u^2+13.14041*u^3+(-48.81398)*max(0,u-0.15)^3+53.54218*max(0,u-0.3)^3+(-19.62216)*max(0,u-0.45)^3+5.46526*max(0,u-0.6)^3+(-0.59419)*max(0,u-0.75)^3
kpf(u)=0.28899+0.10101*u+(-0.27372)*u^2+2.11903*u^3+(-2.57999)*max(0,u-0.15)^3+(-0.92425)*max(0,u-0.3)^3+0.94181*max(0,u-0.45)^3+(-0.20843)*max(0,u-0.6)^3+1.44015*max(0,u-0.75)^3
kph(c)=0.16049*c^4+(-0.11467)*c^3+0.06461*c^2+0.21128*c^1+(-0.01755)
kpe(u)=0.46553+(-0.27802)*u+(-11.51469)*u^2+59.33771*u^3+(-65.71984)*max(0,u-0.04)^3+73.58009*max(0,u-0.08)^3+(-76.04846)*max(0,u-0.12)^3+26.32867*max(0,u-0.17)^3+(-37.9324)*max(0,u-0.24)^3+36.75735*max(0,u-0.33)^3+(-28.4681)*max(0,u-0.45)^3+13.59866*max(0,u-0.6)^3+29.25349*max(0,u-0.75)^3+(-252.32199)*max(0,u-0.9)^3
kpp(u,q)=kpe(u)+q*(2*pi-2*kpe(u))
kpr(u,p)=1+0.045*u^2*cos(18*p)
kpx(u,p,s)=s*kpa(u)*sin(p)*kpr(u,p)
kpy(u,p,s)=0.02-s*(kpf(u)+(kpb(u)-kpf(u))*(1-cos(p))/2)*cos(p)*kpr(u,p)
kpz(u,p)=10.62-1.42*u^1.6-u^4*kph(cos(p))
