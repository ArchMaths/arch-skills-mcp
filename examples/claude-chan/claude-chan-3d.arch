//Skirt: black side panels with orange facings, gold bands and chrysanthemum emblems
# Black side panels under the overskirt, from 29-31 degrees to 152 on each side (measured on the front
# and back views; the pleated skirt shows between them at the front and the back), from just under the bows
# down to a hem near 2, lying on the skirt (the cloth hangs: nothing holds it out). The front edge is faced in orange: a thin edge on
# her right (as traced, one line at the panel's edge), 9 degrees on her left, a wide strip below the front tab. q runs across a panel from
# its front edge, p down it.
bzh(q)=1.95+0.1*sin(pi*q)
eml(k)=(0.2268+0.04095*(((1+cos(2*pi*((k)-(2))/16))/2)^400+((1+cos(2*pi*((k)-(-2))/16))/2)^400)+0.0378*((1+cos(2*pi*((k)-(0))/16))/2)^400+0.1071*((1+cos(2*pi*((k)-(8))/16))/2)^400)
emi(w,kz,la,lb,lc)=((0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la)))+((0.07056+((0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la)))-0.07056)*min(1,(abs((((w)-pi/2)*16/(2*pi))-floor((((w)-pi/2)*16/(2*pi))+0.5))*0.3927)/atan(0.0252/(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la)))))^1.5)-(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))))*(0.5+0.5*sign(atan(0.0252/(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))))-(abs((((w)-pi/2)*16/(2*pi))-floor((((w)-pi/2)*16/(2*pi))+0.5))*0.3927))))
emo(w,kz,la,lb,lc)=((0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la)))+(((la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))-((la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))-(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))))*min(1,(abs((((w)-pi/2)*16/(2*pi))-floor((((w)-pi/2)*16/(2*pi))+0.5))*0.3927)/atan(0.0252/(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la)))))^1.5)-(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))))*(0.5+0.5*sign(atan(0.0252/(0.03528+0.5*(la+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*(lb-la)+(floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)*((floor((((w)-pi/2)*16/(2*pi))+0.5)-kz)-1)/2*(lc-2*lb+la))))-(abs((((w)-pi/2)*16/(2*pi))-floor((((w)-pi/2)*16/(2*pi))+0.5))*0.3927))))
bph(q,p)=5.45-0.1*q-(5.45-0.1*q-bzh(q))*p
pfg(h)=min(1,max(0,(4.6-h)/1.6))^2
pff(h)=0.788-0.0917*(h-2)
pfs(h)=0.36*pfg(h)/(sa(sz(h))+0.09)
pfa(h)=max(0.54,pff(h)-0.407*pfs(h))
pfb(h)=pfa(h)+pfs(h)
pfm(q)=q*q*(3-2*q)
pfr(q)=exp(-(((q)-0.2)/0.03)^2)+exp(-(((q)-0.36)/0.03)^2)+exp(-(((q)-0.52)/0.03)^2)+exp(-(((q)-0.68)/0.03)^2)
pfd(h)=0.035*min(1,max(0,(5-h)/3))
