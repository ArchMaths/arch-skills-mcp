(0.81191*(fwd(h)*sin(f))+0.0572*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.09969)*(h)+1.11963,(-0.05677)*(fwd(h)*sin(f))+0.818*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.00697*(h)+(-0.05693),0.09993*(fwd(h)*sin(f))+0.81389*(h)+2.10307,f,(-0.36),0.36,h,11.87,12.51) | ref=faceBrowMid color=#e5d0cd
(0.81191*(fwd(h)*sin(f))+0.0572*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+(-0.09969)*(h)+1.11963,(-0.05677)*(fwd(h)*sin(f))+0.818*(fpl(h)+fd(h)*(1-abs(cos(f))^(2*fq(h)))+fr(fwd(h)*sin(f),h))+0.00697*(h)+(-0.05693),0.09993*(fwd(h)*sin(f))+0.81389*(h)+2.10307,f,0.36,pi/2,h,11.87,12.51) | ref=faceBrowLeft color=#e5d0cd
# Underside of the jaw: chords between the two sides of the jawline, arched up a little in the middle.
(0.81191*(q*fwd(h))+0.0572*(fpl(h)+fd(h))+(-0.09969)*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+1.11963,(-0.05677)*(q*fwd(h))+0.818*(fpl(h)+fd(h))+0.00697*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+(-0.05693),0.09993*(q*fwd(h))+0.81389*(h+0.05*(1-q^2)*min(1,(h-10.96)/0.2))+2.10307,h,10.96,11.61,q,(-1),1) | ref=jawUnder color=#d2b6b2
# Cranium (under the hair) and neck.
(0.81191*(0+0.655*sin(u)*cos(v))+0.0572*(0.14+0.745*sin(u)*sin(v))+(-0.09969)*(12.15+0.755*cos(u))+1.11963,(-0.05677)*(0+0.655*sin(u)*cos(v))+0.818*(0.14+0.745*sin(u)*sin(v))+0.00697*(12.15+0.755*cos(u))+(-0.05693),0.09993*(0+0.655*sin(u)*cos(v))+0.81389*(12.15+0.755*cos(u))+2.10307,u,0,pi,v,0,2*pi) | ref=cranium color=#e5d0cd
