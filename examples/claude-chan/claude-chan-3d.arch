# Rounded box (superquadric): exponent e near 0 is boxy, 1 is an ellipsoid.
sqc(t,pw)=sign(cos(t))*abs(cos(t))^pw
sqs(t,pw)=sign(sin(t))*abs(sin(t))^pw
# Puffy capsule profile: like cr, plus a bulge bu in the middle.
cpf(u,r0,r1,bu)=(r0+(r1-r0)*cf(u)+bu*sin(u)^2)*sqrt(sqrt(1-cos(u)^4))

//Blouse: body, high ruffled collar and jabot
tsa(s)=0.58+s*((-1.12)+s*(2.52+s*(4.9+s*((-20.3)+s*(30.24+s*((-26.32)+s*(9.68)))))))
tsb(s)=0.41+s*((-0.63)+s*(1.47+s*(3.15+s*((-13.65)+s*(16.59+s*((-9.52)+s*(2.36)))))))
tsz(s)=7.4+s*(4.2+s*((-2.1)+s*(7+s*((-8.75)+s*(3.15+s*((-0.91)+s*(0.63)))))))
bst(xq,zq)=0.24*exp(-(((zq)-9.47)/(0.3+0.07*atan(((zq)-9.47)/0.1)))^2)*(0.45+0.55*exp(-((abs(xq)-0.28)/0.25)^2))
# The body under the blouse, with the bust (bst): two soft mounds, the cloth bridging between them.
(tsa(s)*cos(w),tsb(s)*sin(w)-bst(tsa(s)*cos(w),tsz(s))*max(0,-sin(w)),tsz(s),w,0,2*pi,s,0,1) | ref=blouse color=#f3e9d8
# High collar with a ruffle on top, standing up to just under her chin as the hi-res portrait draws it: the
# band rises to 10.92 and two gathered tiers of lace stand on it, the upper one ending 0.02 under the chin (its lowest
# point is at 11.02), so the neck does not show in front.
((0.235+0.022*s)*cos(w),0.02+(0.235+0.022*s)*sin(w),10.42+0.5*s,w,0,2*pi,s,0,1) | ref=collar color=#f3e9d8
