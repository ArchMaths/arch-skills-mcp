sla(q)=0.29054+0.21052*(q-8)+0.25702*(q-8)^2+0.0968*(q-8)^3+0.39137*max(0,q-9.25)^3+(-1.5048)*max(0,q-8.92)^3+(-3.26486)*max(0,q-8.68)^3+3.12438*max(0,q-8.47)^3+20.19586*max(0,q-8.32)^3+(-30.21942)*max(0,q-8.2)^3+10.66293*max(0,q-8.08)^3+0.22858*max(0,q-7.6)^3+(-0.1141)*max(0,q-7.12)^3
slb(q)=0.52795+1.05518*(q-8)+1.07455*(q-8)^2+0.35741*(q-8)^3+1.63718*max(0,q-9.25)^3+(-6.68746)*max(0,q-8.92)^3+9.3988*max(0,q-8.68)^3+(-15.27116)*max(0,q-8.47)^3+33.08362*max(0,q-8.32)^3+(-31.65831)*max(0,q-8.2)^3+9.08442*max(0,q-8.08)^3+0.42038*max(0,q-7.6)^3+(-0.47799)*max(0,q-7.12)^3
