curve(0.81191*(0.985*fwd((10.92646+0.50754*t)))+0.0572*(fy(0.985*fwd((10.92646+0.50754*t)),(10.92646+0.50754*t))-0.004)+(-0.09969)*((10.92646+0.50754*t))+1.11963,(-0.05677)*(0.985*fwd((10.92646+0.50754*t)))+0.818*(fy(0.985*fwd((10.92646+0.50754*t)),(10.92646+0.50754*t))-0.004)+0.00697*((10.92646+0.50754*t))+(-0.05693),0.09993*(0.985*fwd((10.92646+0.50754*t)))+0.81389*((10.92646+0.50754*t))+2.10307,t,0,1) | ref=jawLineL color=#8a4a3c thickness=1
