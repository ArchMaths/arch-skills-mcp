//Arms: puffed sleeves gathered at the elbow, laced forearm sleeves, frill cuffs, hands
# Sleeve sections at each height q (measured on the sheet's front, side and back views): centre
# slx, sly and half-widths sla across, slb front to back; slg the gathers at the elbow band and the puff's folds.
slx(q)=0.95657+(-1.68584)*(q-8)+(-1.53994)*(q-8)^2+(-0.53119)*(q-8)^3+1.15476*max(0,q-9.25)^3+(-1.96264)*max(0,q-8.92)^3+(-1.15954)*max(0,q-8.68)^3+14.17444*max(0,q-8.47)^3+(-21.95865)*max(0,q-8.32)^3+7.81428*max(0,q-8.2)^3+2.89973*max(0,q-8.08)^3+(-0.87746)*max(0,q-7.6)^3+0.74143*max(0,q-7.12)^3
sly(q)=0.17083+1.08988*(q-8)+0.88287*(q-8)^2+0.30883*(q-8)^3+3.45256*max(0,q-9.25)^3+(-7.16799)*max(0,q-8.92)^3+13.01252*max(0,q-8.68)^3+(-21.25857)*max(0,q-8.47)^3+18.82454*max(0,q-8.32)^3+1.18111*max(0,q-8.2)^3+(-7.30424)*max(0,q-8.08)^3+0.86654*max(0,q-7.6)^3+(-0.44566)*max(0,q-7.12)^3
sla(q)=0.29054+0.21052*(q-8)+0.25702*(q-8)^2+0.0968*(q-8)^3+0.39137*max(0,q-9.25)^3+(-1.5048)*max(0,q-8.92)^3+(-3.26486)*max(0,q-8.68)^3+3.12438*max(0,q-8.47)^3+20.19586*max(0,q-8.32)^3+(-30.21942)*max(0,q-8.2)^3+10.66293*max(0,q-8.08)^3+0.22858*max(0,q-7.6)^3+(-0.1141)*max(0,q-7.12)^3
slb(q)=0.52795+1.05518*(q-8)+1.07455*(q-8)^2+0.35741*(q-8)^3+1.63718*max(0,q-9.25)^3+(-6.68746)*max(0,q-8.92)^3+9.3988*max(0,q-8.68)^3+(-15.27116)*max(0,q-8.47)^3+33.08362*max(0,q-8.32)^3+(-31.65831)*max(0,q-8.2)^3+9.08442*max(0,q-8.08)^3+0.42038*max(0,q-7.6)^3+(-0.47799)*max(0,q-7.12)^3
slg(q)=0.035*exp(-((q-8.27)/0.09)^2)+0.007*(1+tanh((q-8.4)/0.07))
slt(s)=1-2*acos(cos(pi*s))/pi
(1*(slx(q)+sla(q)*cos(t)*(1+slg(q)*cos(16*t))),sly(q)+slb(q)*sin(t)*(1+slg(q)*cos(16*t)),q,t,0,2*pi,q,6.95,9.62) | ref=sleeveL color=#f3e9d8
sfa(k)=(1+cos(pi*k))/2*(8.45+0.03*(sin(1.7*k)+1))+(1-cos(pi*k))/2*(8.95+0.2*(sin(2.39*k+0.7)+1))
slxp(q)=1.19073+((q-8.825)/0.625)*((-0.1982)+((q-8.825)/0.625)*(0.06085+((q-8.825)/0.625)*(0.16936+((q-8.825)/0.625)*(0.07026+((q-8.825)/0.625)*(0.1889+((q-8.825)/0.625)*((-1.80113)+((q-8.825)/0.625)*((-0.28573)+((q-8.825)/0.625)*(3.83874+((q-8.825)/0.625)*((-0.30036)+((q-8.825)/0.625)*((-3.00288)+((q-8.825)/0.625)*(0.29598+((q-8.825)/0.625)*(0.81506))))))))))))
slyp(q)=0.0092+((q-8.825)/0.625)*((-0.25546)+((q-8.825)/0.625)*(0.03079+((q-8.825)/0.625)*(1.5623+((q-8.825)/0.625)*((-1.10816)+((q-8.825)/0.625)*((-4.56994)+((q-8.825)/0.625)*(5.43291+((q-8.825)/0.625)*(6.09011+((q-8.825)/0.625)*((-9.78984)+((q-8.825)/0.625)*((-3.68307)+((q-8.825)/0.625)*(7.65461+((q-8.825)/0.625)*(0.82463+((q-8.825)/0.625)*((-2.22097)))))))))))))
slap(q)=0.31008+((q-8.825)/0.625)*((-0.22649)+((q-8.825)/0.625)*(0.18392+((q-8.825)/0.625)*(0.09871+((q-8.825)/0.625)*((-0.20256)+((q-8.825)/0.625)*(0.35516+((q-8.825)/0.625)*((-0.74984)+((q-8.825)/0.625)*((-0.42988)+((q-8.825)/0.625)*(1.53308+((q-8.825)/0.625)*(0.29573+((q-8.825)/0.625)*((-1.2689)+((q-8.825)/0.625)*((-0.12689)+((q-8.825)/0.625)*(0.42902))))))))))))
slbp(q)=0.36739+((q-8.825)/0.625)*((-0.3537)+((q-8.825)/0.625)*(0.02062+((q-8.825)/0.625)*(1.42011+((q-8.825)/0.625)*((-1.02135)+((q-8.825)/0.625)*((-3.67079)+((q-8.825)/0.625)*(4.18366+((q-8.825)/0.625)*(4.93821+((q-8.825)/0.625)*((-7.39517)+((q-8.825)/0.625)*((-3.00669)+((q-8.825)/0.625)*(5.69607+((q-8.825)/0.625)*(0.63786+((q-8.825)/0.625)*((-1.5963)))))))))))))
